{
  "expo": {
    "name": "Web3 Academy",
    "slug": "web3-academy",
    "version": "1.0.0",
    "scheme": "web3academy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4FD"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.web3academy.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.web3academy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6C3BD9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FD",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "resizeMode": "contain",
            "backgroundColor": "#12101F"
          }
        }
      ],
      "./plugins/withPodDeploymentTarget.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
